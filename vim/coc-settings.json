{
  "list.normalMappings": { "<C-c>": "do:exit" },
  "list.insertMappings": { "<C-c>": "do:exit" },

  "diagnostic.enable": true,
  "diagnostic.displayByAle": false,

  "inlayHint.enable": true,
  "inlayHint.position": "eol",

  "semanticTokens.enable": true,

  "snippets.textmateSnippetsRoots": ["$DOTFILES/vim/snippets"],

  // C/C++
  "clangd.path": "/usr/bin/clangd",
  "clangd.enabled": true,
  "clangd.compilationDatabaseCandidates": ["./build", "./build-qnx"],
  "clangd.arguments": ["--log=verbose"],

  // Python
  "python.linting.enabled": true,
  "python.linting.flake8Enabled": true,
  "python.linting.pylintEnabled": false,
  "python.formatting.provider": "autopep8",
  "python.analysis.autoImportCompletions": false,
  "pyright.enable": true, // https://github.com/fannheyward/coc-pyright

  // Lua
  "Lua.format.enable": true,
  "Lua.format.defaultConfig": {
    "function_parentheses": "None",
    "align_array_table": "false"
  },

  // etc
  "prettier.disableLanguages": ["vim", "c", "cpp", "python"],
  "json.format.enable": true,
  "json.format.keepLines": true
}
